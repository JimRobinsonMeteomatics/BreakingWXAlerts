# Meteomatics REST API credentials (https://www.meteomatics.com)
METEOMATICS_USER=
METEOMATICS_PASS=

# Server
PORT=8787
HOST=127.0.0.1
API_KEY=change-me            # required Bearer token for /api/*; unset = open (local dev only)
WEBHOOK_SECRET=change-me     # shared secret for inbound MSP webhooks
POLL_MINUTES=10
DB_PATH=data/alerts.db

# iMessage via a Mac signed into Messages (personal / beta use only)
IMESSAGE_MAC_ENABLED=0
IMESSAGE_MAC_MIN_GAP_MS=3000

# iMessage via Apple Messages for Business, through your MSP
IMESSAGE_BUSINESS_URL=       # MSP "send message" endpoint
IMESSAGE_BUSINESS_TOKEN=
IMESSAGE_BUSINESS_ID=        # your Business Chat ID

# Web push for the installable phone app. Generate keys with:
#   node -e "const w=require('web-push');console.log(w.generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com   # contact address; sent to push services with each push
# Behind an HTTPS reverse proxy / tunnel:
PUBLIC_URL=                  # the https address people use, shown with new credentials
TRUST_PROXY=0
COOKIE_SECURE=0

# Alerts vanish from people's feeds after this many minutes (0 = never). Records stay in the admin log.
ALERT_TTL_MIN=30
